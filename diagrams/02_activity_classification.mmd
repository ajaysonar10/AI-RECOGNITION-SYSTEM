    W -- "No" --> KA{"Avg knee angle?"}
    KA -- "< 125°" --> SIT["🪑 Sitting<br/>(knees bent)"]
    KA -- "≥ 155°" --> ST["🧍 Standing<br/>(legs straight)"]
    KA -- "125°–155°" --> U2["❓ Unknown<br/>(pose not clear)"]
    WK --> R["Return activity<br/>+ confidence + reasons"]
    SIT --> R
    ST --> R
    U2 --> R
    U --> R
