flowchart TD
    S(["Person detected"]) --> K{"17 keypoints<br/>available?"}
    K -- "No" --> U["❓ Unknown (0%)"]
    K -- "Yes" --> W{"Walking test passes?<br/>movement > 4 px/frame<br/>AND net displacement > 25 px<br/>AND consistency ≥ 0.55<br/>AND 4-frame streak"}
